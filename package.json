{
  "name": "karin-plugin-adapter-qqbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Karin QQ 官方机器人适配器 monorepo",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @karinjs/adapter-qqbot build",
    "dev": "pnpm --filter @karinjs/adapter-qqbot dev",
    "dev:web": "pnpm --filter @karinjs/adapter-qqbot-web dev",
    "docs:dev": "pnpm --filter @karinjs/adapter-qqbot-docs dev",
    "docs:build": "pnpm --filter @karinjs/adapter-qqbot-docs build",
    "docs:start": "pnpm --filter @karinjs/adapter-qqbot-docs start",
    "api-docs:crawl": "pnpm --filter @karinjs/adapter-qqbot-api-docs crawl",
    "api-docs:convert": "pnpm --filter @karinjs/adapter-qqbot-api-docs convert",
    "api-docs:sync": "pnpm --filter @karinjs/adapter-qqbot-api-docs sync",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @karinjs/adapter-qqbot test",
    "test:watch": "pnpm --filter @karinjs/adapter-qqbot test:watch"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
