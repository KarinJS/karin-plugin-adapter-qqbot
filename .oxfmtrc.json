{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/lib/**",
    "**/.next/**",
    "**/.source/**",
    "**/CHANGELOG.md",
    "packages/api-docs/docs/**",
    "packages/api-docs/html/**",
    "packages/api-docs/wiki/**",
    "pnpm-lock.yaml"
  ]
}
